# Tiger Cloud (Postgres + TimescaleDB). Use the "Connection string" from your service, e.g.
# postgres://tsdbadmin:<password>@<service>.tsdb.cloud.timescale.com:<port>/tsdb?sslmode=require
DATABASE_URL=

# LLM. With no key, Harbor runs on its built-in simulator (clearly labelled in the UI).
ANTHROPIC_API_KEY=
# Optional: anthropic | simulated
LLM_PROVIDER=
# Optional: default model for new workspaces (claude-opus-5-5 | claude-sonnet-5-5 | claude-haiku-5-5)
HARBOR_DEFAULT_MODEL=
# Set to 0 to fail runs instead of finishing them on the simulator when the live model is unreachable
HARBOR_SIMULATOR_FALLBACK=

# SerpApi (https://serpapi.com/manage-api-key). Without it, search results are simulated.
SERPAPI_API_KEY=

# Slack incoming webhook (https://api.slack.com/messaging/webhooks). Without it, messages stay in Harbor.
SLACK_WEBHOOK_URL=

# Public URL used in Slack links (defaults to the Vercel URL or http://localhost:3000)
HARBOR_APP_URL=
